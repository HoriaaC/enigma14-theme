    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fluid": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textColumns": true,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Montserrat\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif",
          "name": "Montserrat",
          "slug": "montserrat",
          "fontFace": [
            {
              "fontFamily": "Montserrat",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "src": [
                "https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
              ]
            }
          ]
        },
        {
          "fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif",
          "name": "Inter",
          "slug": "inter",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "src": [
                "https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "Small (12px)",
          "slug": "small",
          "size": "12px"
        },
        {
          "name": "Action / Sub (13px)",
          "slug": "action",
          "size": "13px"
        },
        {
          "name": "Medium (14px)",
          "slug": "medium",
          "size": "14px"
        },
        {
          "name": "Body Large (16px)",
          "slug": "large",
          "size": "16px"
        },
        {
          "name": "Headline Small (18px)",
          "slug": "x-large",
          "size": "18px"
        },
        {
          "name": "Headline Medium (22px)",
          "slug": "xx-large",
          "size": "22px"
        },
        {
          "name": "Headline XL (36px)",
          "slug": "xxx-large",
          "size": "36px"
        },
        {
          "name": "Display Large (48px)",
          "slug": "huge",
          "size": "48px"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--on-surface)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--montserrat)",
      "fontSize": "var(--wp--preset--font-size--large)",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontSize": "var(--wp--preset--font-size--huge)",
          "fontWeight": "800",
          "lineHeight": "1.15",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var(--wp--preset--color--on-surface)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontSize": "var(--wp--preset--font-size--xxx-large)",
          "fontWeight": "700",
          "lineHeight": "1.25",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var(--wp--preset--color--on-surface)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "fontWeight": "700",
          "lineHeight": "1.3"
        },
        "color": {
          "text": "var(--wp--preset--color--on-surface)"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "600",
          "lineHeight": "1.4"
        },
        "color": {
          "text": "var(--wp--preset--color--on-surface)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--secondary-container)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary-container)",
          "text": "var(--wp--preset--color--on-primary-container)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontSize": "var(--wp--preset--font-size--action)",
          "fontWeight": "700",
          "letterSpacing": "0.05em",
          "textTransform": "uppercase"
        },
        "border": {
          "radius": "4px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        }
      }
    }
  }
}
