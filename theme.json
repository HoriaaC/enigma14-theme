          "slug": "tertiary",
          "color": "#ffb3b1"
        },
        {
          "name": "Tertiary Container (Coral Red)",
          "slug": "tertiary-container",
          "color": "#ff7273"
        },
        {
          "name": "On Tertiary",
          "slug": "on-tertiary",
          "color": "#680011"
        },
        {
          "name": "On Tertiary Container",
